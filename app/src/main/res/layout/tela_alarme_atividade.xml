<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6E7EA"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/silkscreen_bold"
        android:text="Hora da pílula"
        android:textColor="#5A2E3A"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/txt_tentativa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/silkscreen_regular"
        android:textColor="#5A2E3A"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_tomei"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="#B86D82"
        android:fontFamily="@font/silkscreen_regular"
        android:text="Tomei"
        android:textColor="#FFFFFF"
        app:cornerRadius="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_nao_tomei"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FFFFFF"
        android:fontFamily="@font/silkscreen_regular"
        android:text="Ainda não"
        android:textColor="#B86D82"
        app:cornerRadius="0dp"
        app:strokeColor="#B86D82"
        app:strokeWidth="2dp" />
</LinearLayout>