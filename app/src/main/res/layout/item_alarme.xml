<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/card_alarme"
    android:minHeight="50dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingVertical="12dp"
        android:paddingStart="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/silkscreen_regular"
            android:text="ALARME REGISTRADO"
            android:textColor="#5A2E3A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txt_horario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/silkscreen_regular"
            android:text="Horário: 20:00"
            android:textColor="#5A2E3A"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/txt_intervalo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/silkscreen_regular"
            android:text="Intervalo: 5 min"
            android:textColor="#5A2E3A"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/txt_limite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/silkscreen_regular"
            android:text="Limite de repetições: 3"
            android:textColor="#5A2E3A"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/botao_editar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Editar alarme"
            android:src="@drawable/ic_editar"
            app:tint="#B86D82"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <ImageButton
            android:id="@+id/botao_excluir"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Excluir alarme"
            android:src="@drawable/ic_lixeira"
            app:tint="#5A2E3A"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_ativo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            app:thumbTint="#FFFFFF"
            app:trackTint="@color/color_switch"
            app:trackDecorationTint="@android:color/transparent"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>
</FrameLayout>