<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Conteúdo da tela -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7E7E4"
        tools:context=".main">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="@drawable/fundo_tela"
            app:navigationContentDescription="Abrir menu"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:navigationIcon="@drawable/bars_icon_small"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/silkscreen_bold"
            android:text="CICLI"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            app:layout_constraintTop_toTopOf="@id/toolbar"
            app:layout_constraintBottom_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="@id/toolbar"
            app:layout_constraintEnd_toEndOf="@id/toolbar" />

        <!-- Busca -->
        <AutoCompleteTextView
            android:id="@+id/busca"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/search"
            android:completionThreshold="1"
            android:hint="Pesquise sobre anticoncepcionais"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Alarme -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_alarme"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_alarme"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/busca"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/icone_pilula"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/pilula_pixel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/texto_titulo_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/silkscreen_regular"
                android:includeFontPadding="false"
                android:text="Sua pílula de hoje"
                android:textColor="#5A2E3A"
                android:textSize="11sp"
                app:layout_constraintStart_toEndOf="@id/icone_pilula"
                app:layout_constraintTop_toTopOf="@id/icone_pilula"
                app:layout_constraintBottom_toBottomOf="@id/icone_pilula" />

            <TextView
                android:id="@+id/texto_nome_pilula"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/silkscreen_bold"
                android:includeFontPadding="false"
                android:text="NOME DA PÍLULA"
                android:textColor="#5A2E3A"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/icone_pilula" />

            <TextView
                android:id="@+id/texto_comprimido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/silkscreen_regular"
                android:includeFontPadding="false"
                android:text="Comprimido 14 de 24+4"
                android:textColor="#8A7A7D"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/texto_nome_pilula" />


            <TextView
                android:id="@+id/texto_proximo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/silkscreen_regular"
                android:includeFontPadding="false"
                android:text="Próximo horário"
                android:textColor="#5A2E3A"
                android:textSize="9sp"
                app:layout_constraintTop_toBottomOf="@id/texto_comprimido" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/silkscreen_bold"
                android:includeFontPadding="false"
                android:text="20:00"
                android:textColor="#5A2E3A"
                android:textSize="24sp"
                app:layout_constraintStart_toStartOf="@id/texto_proximo"
                app:layout_constraintTop_toBottomOf="@id/texto_proximo" />

            <!-- Botão antes do primeiro alarme -->
            <ImageView
                android:id="@+id/urso_manha"
                android:layout_width="120dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:src="@drawable/manha"
                app:layout_constraintBottom_toBottomOf="@id/clock"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/texto_nome_pilula"
                android:importantForAccessibility="no"/>

            <ImageView
                android:id="@+id/urso_noite"
                android:layout_width="120dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:src="@drawable/noite"
                app:layout_constraintBottom_toBottomOf="@id/clock"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/texto_nome_pilula"
                android:importantForAccessibility="no"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_alarme_teste"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="5dp"
                android:backgroundTint="#B86D82"
                android:fontFamily="@font/silkscreen_regular"
                android:text="DEFINIR ALARME"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@id/clock"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Botão depois do primeiro alarme -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_tomei"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#5A2E3A"
                android:fontFamily="@font/silkscreen_regular"
                android:text="Tomei minha pílula"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:icon="@drawable/period"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="#F6BCC9"
                app:layout_constraintTop_toBottomOf="@id/clock"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Histórico -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_historico"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_alarme"
            app:layout_constraintTop_toBottomOf="@id/card_alarme"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/icone_historico"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="24dp"
                android:src="@drawable/history_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:importantForAccessibility="no"/>

            <ImageView
                android:id="@+id/press"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginStart="6dp"
                android:paddingTop="5dp"
                android:src="@drawable/press"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:importantForAccessibility="no"
                app:layout_constraintStart_toEndOf="@id/icone_historico" />

            <TextView
                android:id="@+id/texto_historico"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/silkscreen_regular"
                android:includeFontPadding="false"
                android:text="HISTÓRICO"
                android:textColor="#B86D82"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/press" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Período -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_periodo"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_alarme"
            app:layout_constraintTop_toBottomOf="@id/card_historico"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            app:navigationContentDescription="Período menstrual">

            <ImageView
                android:id="@+id/icone_periodo"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginStart="24dp"
                android:src="@drawable/period"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/texto_periodo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/silkscreen_regular"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="#B86D82"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/icone_periodo"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/texto_mes_ano"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/silkscreen_regular"
            android:includeFontPadding="false"
            android:text="NOVEMBRO 2026"
            android:textColor="#5A2E3A"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/card_periodo"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Calendário -->
        <LinearLayout
            android:id="@+id/card_calendario"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_alarme"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="7"
            app:layout_constraintTop_toBottomOf="@id/texto_mes_ano"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            app:navigationContentDescription="Calendário">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/silkscreen_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="20\nSEG"
                android:textColor="#8A7A7D"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/silkscreen_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="21\nTER"
                android:textColor="#8A7A7D"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/silkscreen_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="22\nQUA"
                android:textColor="#8A7A7D"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dia_atual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/silkscreen_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="23\nQUI"
                android:textColor="#B86D82"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/silkscreen_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="24\nSEX"
                android:textColor="#8A7A7D"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/silkscreen_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="25\nSÁB"
                android:textColor="#8A7A7D"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/silkscreen_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="26\nDOM"
                android:textColor="#8A7A7D"
                android:textSize="14sp" />
        </LinearLayout>

    <LinearLayout
        android:id="@+id/card_aviso"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/fundo_aviso"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constrainedHeight="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aviso_troca"
            android:textColor="#5A2E3A"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botao_entendi_aviso"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="Entendi"
            android:fontFamily="@font/silkscreen_regular"
            android:textColor="#B86D82"
            android:textSize="11sp" />
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <!-- Menu lateral -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F6E7EA"
        android:orientation="vertical">

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_lateral"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F6E7EA"
            app:headerLayout="@layout/nad_head"
            app:itemTextAppearance="@style/TextoMenu"
            app:itemTextColor="#5A2E3A"
            app:menu="@menu/menu_lateral" />

        <TextView
            android:id="@+id/texto_conforto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/texto_conforto"
            android:textColor="#6B4A55"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>

