<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7E7E4"
    android:fitsSystemWindows="true"
    tools:context=".cadastro">

    <!-- Topo -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="#B86D82"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/silkscreen_bold"
            android:text="CICLI"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Formulário -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/silkscreen_regular"
                android:text="Seu nome" />

            <EditText
                android:id="@+id/edit_nome"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_alarme"
                android:paddingHorizontal="12dp"
                android:hint="Digite seu nome"
                android:inputType="textPersonName" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/silkscreen_regular"
                android:text="Data de nascimento" />

            <EditText
                android:id="@+id/edit_nascimento"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_alarme"
                android:paddingHorizontal="12dp"
                android:hint="dd/mm/aaaa"
                android:inputType="number"
                android:maxLength="10"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/silkscreen_regular"
                android:text="Anticoncepcional" />

            <AutoCompleteTextView
                android:id="@+id/edit_anticoncepcional"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_alarme"
                android:paddingHorizontal="12dp"
                android:hint="Digite o anticoncepcional que você toma"
                android:completionThreshold="1"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/silkscreen_regular"
                android:text="Tipo da cartela" />

            <Spinner
                android:id="@+id/spinner_cartela"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_alarme"
                android:paddingHorizontal="12dp"
                android:entries="@array/tipos_cartela" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/silkscreen_regular"
                android:text="Último dia que iniciou a cartela" />

            <EditText
                android:id="@+id/edit_inicio_cartela"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_alarme"
                android:paddingHorizontal="12dp"
                android:hint="dd/mm/aaaa"
                android:inputType="number"
                android:maxLength="10" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botao_concluir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="28dp"
                android:backgroundTint="#B86D82"
                android:fontFamily="@font/silkscreen_regular"
                android:text="Concluir"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:cornerRadius="0dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>